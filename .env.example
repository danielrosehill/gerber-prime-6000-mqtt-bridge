# Controller (find its LAN IP / set a static DHCP reservation first)
GERBER_HOST=192.168.1.80
GERBER_USER=admin
GERBER_PASS=888888
# uid from get_all_device (257 seems to be the PAN27 default)
GERBER_UID=257
# Which channel ids are relays and which are roller shutters — read yours from
# get_all_device: ctrltype 23 = relay, 26 = shutter.
RELAY_CHIDS=1,2,3,4,5,6
SHUTTER_CHIDS=7

# MQTT broker (the one your Home Assistant MQTT integration points at)
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

MQTT_BASE_TOPIC=gerber/gps6000
DEVICE_NAME=Gerber Prime 6000
POLL_INTERVAL=10
